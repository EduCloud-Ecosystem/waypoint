{
  "name": "waypoint-mobile",
  "displayName": "Waypoint Mobile Workspace",
  "publisher": "educloud",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "waypoint.mobile",
        "title": "Waypoint: Open mobile controls"
      },
      {
        "command": "waypoint.phone",
        "title": "Waypoint: Use phone layout"
      },
      {
        "command": "waypoint.desktop",
        "title": "Waypoint: Restore previous layout"
      },
      {
        "command": "waypoint.inspect",
        "title": "Waypoint: Inspect paused values"
      }
    ]
  }
}

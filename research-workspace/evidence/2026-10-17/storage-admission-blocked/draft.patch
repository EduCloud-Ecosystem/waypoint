new file mode 100644
index 0000000..6425bce
--- /dev/null
+++ b/research-workspace/research_workspace/storage.py
@@ -0,0 +1,395 @@
+"""Versioned local capacity authority for explicitly managed synthetic stores.
+
+Logical limits do not reserve physical disk against other host writers. Durable
+intent precedes effects; uncertain and completed run envelopes are retained.
+"""
+
+from contextlib import contextmanager
+import fcntl
+import json
+import math
+import os
+from pathlib import Path
+import re
+import secrets
+import stat
+import threading
+
+FORMAT = "educloud-storage-admission-v1"
+DEFAULT_BYTES = 64 * 1024 * 1024
+DEFAULT_ENTRIES = 4096
+MAX_POLICY_BYTES = 65536
+PAGE_SIZE = 4096
+# Each table has a row limit, encoded record ceiling and index-key ceilings.
+# Overflow pages have four-byte links; 2*n+1 bounds each tree's nodes. Twice
+# the full live layout covers replacement rows/trees without relying on reuse.
+PROFILE = {
+    "users": (16, 512, (128, 128)),
+    "sessions": (16, 512, (128,)),
+    "projects": (8, 65536 + 512, (128,)),
+    "members": (32, 512, (256,)),
+    "runs": (16, 262144 + 1024, (128, 32, 256)),
+}
+LIVE_PAGES = sum(n * math.ceil(record / (PAGE_SIZE - 4)) + 2*n + 1
+                 + sum(n * math.ceil(key / (PAGE_SIZE - 4)) + 2*n + 1 for key in indexes)
+                 for n, record, indexes in PROFILE.values())
+LAYOUT_PAGES = 2 * LIVE_PAGES + 128
+DB_PAGES = 1 << (LAYOUT_PAGES - 1).bit_length()
+DB_BYTES = DB_PAGES * PAGE_SIZE
+# unix VFS, one DELETE-journal transaction, cache spill disabled. Include
+# original pages, eight bytes per page record, and generous header padding.
+JOURNAL_BYTES = DB_PAGES * (PAGE_SIZE + 8) + 65536
+APPLICATION_ID = 0x45535731
+INPUT_BYTES = RECIPE_BYTES = 65536
+REQUEST_BYTES = 65536
+RECEIPT_BYTES = 6 * 262144
+RESULT_BYTES = 262144
+OUTPUT_BYTES = 6 * 65536 + 512
+RUN_BYTES = 2*(INPUT_BYTES + RECIPE_BYTES) + REQUEST_BYTES + RECEIPT_BYTES + RESULT_BYTES + 2*OUTPUT_BYTES + 6
+RUN_ENTRIES = 18
+BROKER_RECORD_BYTES = 96 * 1024
+BOOT = secrets.token_hex(16)
+_registry_lock = threading.Lock()
+_registry = {}
+
+
+class StorageError(ValueError):
+    pass
+
+
+class CapacityError(StorageError):
+    def __init__(self):
+        super().__init__("Workspace storage is full for new work. Your draft is preserved; ask the operator. Existing work and safety controls retain their reserved space.")
+
+
+def encode(value):
+    return json.dumps(value, sort_keys=True, separators=(",", ":"), allow_nan=False).encode()
+
+
+def decode(value):
+    def pairs(items):
+        result = {}
+        for key, item in items:
+            if key in result:
+                raise StorageError("Storage authority has duplicate fields; admission is held.")
+            result[key] = item
+        return result
+    return json.loads(value, object_pairs_hook=pairs,
+                      parse_constant=lambda _: (_ for _ in ()).throw(StorageError("Invalid storage authority.")))
+
+
+def read_private(path, maximum=MAX_POLICY_BYTES):
+    fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW)
+    try:
+        info = os.fstat(fd)
+        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or info.st_size > maximum:
+            raise StorageError("Storage authority is linked, special or oversized; admission is held.")
+        data = b""
+        while len(data) <= maximum:
+            chunk = os.read(fd, min(65536, maximum + 1 - len(data)))
+            if not chunk:
+                break
+            data += chunk
+        after = os.fstat(fd)
+        if (info.st_size, info.st_mtime_ns, info.st_ctime_ns) != (len(data), after.st_mtime_ns, after.st_ctime_ns):
+            raise StorageError("Storage authority changed during reading; admission is held.")
+        return data
+    finally:
+        os.close(fd)
+
+
+def limits(logical_bytes=DEFAULT_BYTES, filesystem_entries=DEFAULT_ENTRIES):
+    if (type(logical_bytes) is not int or type(filesystem_entries) is not int
+            or not DB_BYTES + JOURNAL_BYTES + 4*MAX_POLICY_BYTES + 65536 <= logical_bytes <= 128*1024*1024
+            or not 64 <= filesystem_entries <= 16384):
+        raise StorageError("Choose a supported finite storage policy with room for authority and settlement.")
+    return {"logical_bytes": logical_bytes, "filesystem_entries": filesystem_entries}
+
+
+def physical_preflight(parent, size, entries):
+    usage = os.statvfs(parent)
+    if usage.f_bavail * usage.f_frsize < size or (usage.f_files and usage.f_favail < entries):
+        raise CapacityError()
+
+
+class _Lease:
+    def __init__(self):
+        self.lock = threading.RLock()
+        self.depth = 0
+        self.fd = None
+        self.broken = False
+        self.active_db = set()
+
+
+class Storage:
+    def __init__(self, root):
+        self.root = Path(root).resolve()
+        with _registry_lock:
+            self.lease = _registry.setdefault(str(self.root), _Lease())
+
+    @staticmethod
+    def present(root):
+        root = Path(root)
+        path = root / "storage.json"
+        if path.exists() or path.is_symlink():
+            return True
+        database = root / "workspace.sqlite3"
+        if database.exists():
+            fd = os.open(database, os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW)
+            try:
+                header = os.read(fd, 100)
+            finally:
+                os.close(fd)
+            if len(header) >= 72 and int.from_bytes(header[68:72], "big") == APPLICATION_ID:
+                raise StorageError("Managed storage authority is missing. Restore it; do not create fresh allowance.")
+        return False
+
+    @classmethod
+    def create(cls, root, policy):
+        policy = limits(**policy)
+        item = cls(root)
+        if (item.root / "storage.json").exists() or (item.root / "storage.lock").exists():
+            raise StorageError("Storage authority already exists; it cannot be reinitialized.")
+        physical_preflight(item.root, policy["logical_bytes"], policy["filesystem_entries"])
+        fd = os.open(item.root / "storage.lock", os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
+        try:
+            os.fsync(fd)
+        finally:
+            os.close(fd)
+        with item.locked(load=False):
+            item.save({"format": FORMAT, "policy": policy, "generation": 0,
+                       "pending_db": {}, "runs": {}, "projects": {}})
+        return item
+
+    @contextmanager
+    def locked(self, *, load=True):
+        with self.lease.lock:
+            outer = self.lease.depth == 0
+            if outer:
+                self.lease.fd = os.open(self.root / "storage.lock", os.O_RDWR | os.O_NOFOLLOW | os.O_NONBLOCK)
+                info = os.fstat(self.lease.fd)
+                if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
+                    os.close(self.lease.fd); self.lease.fd = None
+                    raise StorageError("Storage lock is invalid; admission is held.")
+                fcntl.flock(self.lease.fd, fcntl.LOCK_EX)
+            self.lease.depth += 1
+            try:
+                yield self.load() if load else None
+            finally:
+                self.lease.depth -= 1
+                if outer:
+                    fd = self.lease.fd; self.lease.fd = None
+                    try:
+                        current = (self.root / "storage.lock").lstat()
+                        if (current.st_dev, current.st_ino, current.st_nlink) != (info.st_dev, info.st_ino, 1):
+                            self.lease.broken = True
+                            raise StorageError("Storage lock was replaced; admission is held.")
+                    finally:
+                        os.close(fd)
+
+    def load(self):
+        try:
+            data = decode(read_private(self.root / "storage.json"))
+            if set(data) != {"format", "policy", "generation", "pending_db", "runs", "projects"} or data["format"] != FORMAT:
+                raise ValueError()
+            limits(**data["policy"])
+            if type(data["generation"]) is not int or not 0 <= data["generation"] < 2**63:
+                raise ValueError()
+            for key, maximum in (("pending_db", 16), ("runs", 16), ("projects", 8)):
+                if not isinstance(data[key], dict) or len(data[key]) > maximum:
+                    raise ValueError()
+                for identity, record in data[key].items():
+                    if not re.fullmatch(r"[a-f0-9]{32}", identity) or not isinstance(record, dict):
+                        raise ValueError()
+                    if not isinstance(record.get("boot"), str) or not re.fullmatch(r"[a-f0-9]{32}", record["boot"]):
+                        raise ValueError()
+                    if key == "pending_db":
+                        if set(record) != {"boot", "kind"} or record["kind"] != "workspace-mutation":
+                            raise ValueError()
+                    elif key == "projects":
+                        if set(record) != {"boot", "phase"} or record["phase"] not in {"preparing", "committed"}:
+                            raise ValueError()
+                    else:
+                        if (set(record) != {"project", "subject", "request_key", "request_hash", "phase", "boot"}
+                                or record["phase"] not in {"preparing", "queued", "running", "settled", "uncertain"}
+                                or not all(isinstance(record[k], str) and re.fullmatch(r"[A-Za-z0-9_-]{1,80}", record[k]) for k in ("project", "subject"))
+                                or not isinstance(record["request_hash"], str) or not re.fullmatch(r"[a-f0-9]{64}", record["request_hash"])
+                                or (record["request_key"] is not None and (not isinstance(record["request_key"], str) or not re.fullmatch(r"[A-Za-z0-9_-]{1,80}", record["request_key"])))):
+                            raise ValueError()
+            return data
+        except (OSError, ValueError, TypeError, KeyError) as exc:
+            raise StorageError("Storage authority is missing or unsupported; existing allowance is held.") from exc
+
+    def save(self, data):
+        data["generation"] += 1
+        payload = encode(data)
+        if len(payload) > MAX_POLICY_BYTES:
+            raise StorageError("Storage intent capacity is exhausted; existing records remain protected.")
+        temporary = self.root / (".storage-" + secrets.token_hex(16))
+        try:
+            fd = os.open(temporary, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW, 0o600)
+            with os.fdopen(fd, "wb") as target:
+                target.write(payload); target.flush(); os.fsync(target.fileno())
+            os.replace(temporary, self.root / "storage.json")
+            directory = os.open(self.root, os.O_RDONLY | os.O_DIRECTORY)
+            try:
+                os.fsync(directory)
+            finally:
+                os.close(directory)
+        except BaseException:
+            # Preserve any partial file and the preceding durable intent. No
+            # repair/write is required to keep this process from dispatching.
+            self.lease.broken = True
+            raise
+
+    def held(self, data):
+        return (self.lease.broken or any(key not in self.lease.active_db for key in data["pending_db"])
+                or any(row.get("phase") != "committed" for row in data["projects"].values())
+                or any(row.get("phase") in {"preparing", "uncertain"} or
+                       (row.get("phase") == "running" and row.get("boot") != BOOT)
+                       for row in data["runs"].values()))
+
+    def measure(self):
+        # This does not hash a live broker's files. Their future growth has
+        # already been charged in durable envelopes. Unknown entries still count.
+        entries, total = {}, 0
+        for parent, directories, files in os.walk(self.root, followlinks=False):
+            path = Path(parent)
+            for candidate in [path, *(path/name for name in files)]:
+                relative = candidate.relative_to(self.root).as_posix()
+                try:
+                    info = candidate.lstat()
+                except FileNotFoundError:
+                    if relative.startswith("broker/") and ("/.ledger-" in relative or "/.output-" in relative or re.fullmatch(r"broker/watch-[a-f0-9]{32}\.ready", relative)):
+                        continue
+                    raise StorageError("Unclassified storage changed; admission is held.")
+                if stat.S_ISDIR(info.st_mode):
+                    size = 0
+                elif stat.S_ISREG(info.st_mode) and info.st_nlink == 1:
+                    size = info.st_size
+                else:
+                    raise StorageError("Linked or special storage remains protected; admission is held.")
+                entries[relative] = size; total += size
+                if len(entries) > 16384 or total > 128*1024*1024:
+                    raise StorageError("Storage exceeds the finite inventory ceiling; usage is not zero.")
+            for name in directories:
+                if not stat.S_ISDIR((path/name).lstat().st_mode):
+                    raise StorageError("Linked or special directories remain protected; admission is held.")
+        return total, len(entries), entries
+
+    @staticmethod
+    def control_remaining(data, entries, extra_runs=0, extra_projects=0):
+        records = len(data["runs"]) + extra_runs
+        projects = len(data["projects"]) + extra_projects
+        ledger = 4096 + records*BROKER_RECORD_BYTES + projects*512
+        # Four possible broker writers: run, watchdog, one cancellation and one
+        # project-init. Failed temporary files are never assumed removed.
+        remaining = max(0, DB_BYTES - entries.get("workspace.sqlite3", 0)) + JOURNAL_BYTES
+        remaining += 4*ledger + 4*MAX_POLICY_BYTES
+        return remaining, 24
+
+    def check(self, data, *, new_run=False, new_project=False, essential=False):
+        if not essential and self.held(data):
+            raise StorageError("Storage has unfinished or uncertain work. New admission and dispatch are held; ask the operator.")
+        size, count, entries = self.measure()
+        growth, new_entries = self.control_remaining(data, entries, int(new_run), int(new_project))
+        if not essential:
+            # Envelopes are intentionally retained even after settlement. This
+            # finite pilot cannot reclaim allowance through retries or restart.
+            growth += (len(data["runs"]) + int(new_run))*RUN_BYTES
+            new_entries += (len(data["runs"]) + int(new_run))*RUN_ENTRIES
+        policy = data["policy"]
+        if size + growth > policy["logical_bytes"] or count + new_entries > policy["filesystem_entries"]:
+            raise CapacityError()
+        physical_preflight(self.root, growth, new_entries)
+        return {"logical_bytes": size, "filesystem_entries": count,
+                "reserved_growth_bytes": growth, "reserved_growth_entries": new_entries}
+
+    def begin_db(self, kind):
+        data = self.load()
+        self.check(data, essential=True)
+        if len(data["pending_db"]) >= 16:
+            raise StorageError("Uncertain database intents require operator reconciliation.")
+        identity = secrets.token_hex(16)
+        data["pending_db"][identity] = {"boot": BOOT, "kind": kind}
+        self.save(data); self.lease.active_db.add(identity)
+        return identity
+
+    def end_db(self, identity, success):
+        try:
+            if success:
+                data = self.load(); del data["pending_db"][identity]; self.save(data)
+            else:
+                self.lease.broken = True
+        finally:
+            self.lease.active_db.discard(identity)
+
+    def row_admission(self, db, table):
+        data = self.load(); self.check(data)
+        if db.execute("SELECT count(*) FROM " + table).fetchone()[0] >= PROFILE[table][0]:
+            raise CapacityError()
+
+    def reserve_run(self, rid, project, subject, request_key, request_hash):
+        data = self.load()
+        for identity, record in data["runs"].items():
+            if request_key and (record.get("project"), record.get("subject"), record.get("request_key")) == (project, subject, request_key):
+                if record.get("request_hash") != request_hash:
+                    raise StorageError("This request ID was already used for different inputs.")
+                raise StorageError("This request has an existing storage intent. Reconcile it; it will not be replayed.")
+        if len(data["runs"]) >= PROFILE["runs"][0]:
+            raise CapacityError()
+        self.check(data, new_run=True)
+        data["runs"][rid] = {"project": project, "subject": subject, "request_key": request_key,
+                              "request_hash": request_hash, "phase": "preparing", "boot": BOOT}
+        self.save(data)
+
+    def run_phase(self, rid, phase):
+        if phase not in {"queued", "running", "settled", "uncertain"}:
+            raise StorageError("Unsupported storage intent transition.")
+        data = self.load(); data["runs"][rid].update(phase=phase, boot=BOOT); self.save(data)
+
+    def reserve_project(self, pid):
+        data = self.load()
+        if len(data["projects"]) >= PROFILE["projects"][0]:
+            raise CapacityError()
+        self.check(data, new_project=True)
+        data["projects"][pid] = {"phase": "preparing", "boot": BOOT}; self.save(data)
+
+    def commit_project(self, pid):
+        data = self.load(); data["projects"][pid]["phase"] = "committed"; self.save(data)
+
+    def before_open(self):
+        for name in ("workspace.sqlite3-journal", "workspace.sqlite3-wal", "workspace.sqlite3-shm"):
+            path = self.root/name
+            if path.exists() and path.stat().st_size:
+                raise StorageError("SQLite recovery files are retained. Ordinary opening is held pending offline reconciliation.")
+        database = self.root / "workspace.sqlite3"
+        if database.exists():
+            info = database.lstat()
+            if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or info.st_size > DB_BYTES:
+                raise StorageError("Database is linked, special or beyond its reserved capacity.")
+
+    def configure(self, db, *, create=False):
+        if ("TEMP_STORE=0",) in db.execute("PRAGMA compile_options").fetchall():
+            raise StorageError("This SQLite build cannot keep temporary operations in memory.")
+        if not create and db.execute("PRAGMA application_id").fetchone()[0] != APPLICATION_ID:
+            raise StorageError("The database is not bound to this storage policy; use explicit offline migration.")
+        if create:
+            db.execute("PRAGMA auto_vacuum=NONE")
+            db.execute("PRAGMA encoding='UTF-8'")
+        elif db.execute("PRAGMA auto_vacuum").fetchone()[0] != 0 or db.execute("PRAGMA encoding").fetchone()[0] != "UTF-8":
+            raise StorageError("Unsupported database page layout; admission is held.")
+        settings = {"page_size": PAGE_SIZE, "max_page_count": DB_PAGES,
+                    "journal_mode": "DELETE", "synchronous": "EXTRA", "temp_store": "MEMORY", "cache_spill": "OFF"}
+        for name, value in settings.items():
+            db.execute("PRAGMA " + name + "=" + str(value))
+        expected = {"page_size": PAGE_SIZE, "max_page_count": DB_PAGES, "journal_mode": "delete",
+                    "synchronous": 3, "temp_store": 2, "cache_spill": 0}
+        if any(db.execute("PRAGMA " + name).fetchone()[0] != value for name, value in expected.items()):
+            raise StorageError("SQLite could not establish the bounded durable profile.")
+        if create:
+            db.execute("PRAGMA application_id=" + str(APPLICATION_ID))
+        else:
+            from .storage_inventory import _supported_schema
+            if not _supported_schema(db):
+                raise StorageError("Unsupported database schema; admission is held.")

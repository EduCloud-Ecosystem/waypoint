# Local-only secrets and env. Never commit real values. The committed example
# lives at templates/dot-env.example.
.env
.env.*

# Local persistent-volume data from docker-compose.dev.yml (e.g. demo-survey).
**/data/
.data/

# Python bytecode.
__pycache__/
*.pyc

# Not part of this project: a personal website working copy and a throwaway
# resume note that lived in this folder. Excluded so they are never published.
/index.HTML
/RESTART_POST_DOCKER.MD

# Local session handoff notes (resume aids), not for publication.
/SESSION_HANDOFF_*.md

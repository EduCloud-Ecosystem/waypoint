# One deployment per course. Existing volumes must keep this stable.
WORKSPACE_INSTANCE=python-r-pilot
WORKSPACE_IMAGE=educloud-python-r:2026-10-06
WORKSPACE_PORT=18000
WORKSPACE_AUTH_MODE=oidc
# Supply HTTPS and wildcard DNS/TLS for *.work.example.edu on a dedicated domain.
WORKSPACE_PUBLIC_URL=https://work.example.edu
WORKSPACE_OIDC_ISSUER=https://auth.example.edu/realms/educloud
WORKSPACE_OIDC_CLIENT_ID=course-workspace
WORKSPACE_OIDC_CLIENT_SECRET=
# Verified OIDC subject IDs, not email addresses. Default: nobody admitted.
WORKSPACE_ALLOWED_SUBJECTS=
WORKSPACE_MEMORY_MB=2048
WORKSPACE_CPU_LIMIT=1
WORKSPACE_ACTIVE_LIMIT=4
WORKSPACE_IDLE_SECONDS=1800
WORKSPACE_MAX_AGE_SECONDS=28800
